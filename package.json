{
  "name": "mcp-warden",
  "version": "0.1.0-alpha.1",
  "description": "Windows lifecycle supervisor for local MCP sessions",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
