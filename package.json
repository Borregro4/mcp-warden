  },
  "dependencies": {
    "supergateway": "4.2.0",
    "@modelcontextprotocol/sdk": "1.32.0"
  },
  "overrides": {
    "@modelcontextprotocol/node": "2.1.2",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@modelcontextprotocol/client": "2.3.0",
    "@modelcontextprotocol/server": "2.3.0",
    "zod": "4.6.6"
  }
}
